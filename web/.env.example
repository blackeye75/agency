# Supabase project "agency-website" (Mumbai). Both values are public by design:
# the publishable key only allows what the database's row level security allows.
NEXT_PUBLIC_SUPABASE_URL=https://lfftdrhhrpcnbqosxnbb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__BkoLSuqiYcp7FUzXVGCcA_KQPcjOV0

# The site's public address (used for SEO tags, sitemap and auth email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enquiry emails through Gmail (optional; without them enquiries are only saved to the CMS).
# GMAIL_APP_PASSWORD is an app password from Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where enquiries are sent (comma separated). Defaults to GMAIL_USER.
LEADS_NOTIFY_TO=
# "true" also emails the visitor a short "we got your message" reply.
LEADS_AUTOREPLY=false
